<html lang='hu'>
  <head>
    <meta charset='UTF-8' />
    <link rel='stylesheet' href='{{stylesheet}}' />
    <title>{{title}}</title>
  </head>
  <body>
    <nav>
      <img class='logo' src='{{logoSrc}}' alt='logo' />
      <a href='{{indexLink}}'>Főoldal</a>
      <a href='{{hirdetesLink}}'>Hirdetés</a>
    </nav>
    <div class='kepfeltolt'>
      <form action='{{submitPicformMethod}}' method='POST' enctype='multipart/form-data'>
        <label for='adId'>Hirdetés ID:</label>
        <input type='number' id='adId' name='adId' placeholder='{{hirdetesID}}' />
        <label for='kep'>Kép:</label>
        <input type='file' id='kep' name='kep' />
        <button type='submit' id='feltolt'>Kép feltöltése</button>
        <button type='button' id='clear-kep'>Törlés</button>
      </form>
    </div>
    <footer>{{footerText}}</footer>
    <script src='script.js'></script>
  </body>
</html>